# Polaris Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://polaris:polaris@localhost:5432/polaris_dev

# ---------------------------------------------------------------------------
# AI Provider
# Set AI_PROVIDER to one of: gemini | ollama | openai | mock
# Defaults to 'mock' when not set (keyword-based, no network).
# ---------------------------------------------------------------------------

AI_PROVIDER=gemini

# -- Gemini (primary cloud provider — recommended) --
# Get your API key at https://aistudio.google.com/
# Default model: gemma-4-26b-a4b-it (1,500 RPD free tier, function calling verified)
# Use gemini-2.5-flash for higher quality (20 RPD limit on free tier).
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# -- Ollama (local inference — offline fallback only, ~72-278s latency) --
# Install from https://ollama.com/ and pull: ollama pull gemma4:e4b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# -- OpenAI --
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Voice transcription (Whisper microservice)
# Run with: docker-compose up whisper
# ---------------------------------------------------------------------------
WHISPER_URL=http://localhost:8001

# ---------------------------------------------------------------------------
# CORS (production only — leave empty for dev)
# Comma-separated list of allowed origins.
# ---------------------------------------------------------------------------
# CORS_ORIGIN=https://polaris.example.com
