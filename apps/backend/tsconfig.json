{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDirs": ["src", "../../packages/shared/src", "../../packages/ai/src"],
    "types": ["node"],
    "paths": {
      "@polaris/shared": ["../../packages/shared/src/index.ts"],
      "@polaris/ai":     ["../../packages/ai/src/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/shared/src/**/*",
    "../../packages/ai/src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
